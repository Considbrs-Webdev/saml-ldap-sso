<?xml version="1.0"?>
<ruleset name="SAML LDAP SSO">
	<description>WordPress Coding Standards with PSR-4 exceptions.</description>
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sls"/>
				<element value="SLS"/>
				<element value="SamlLdapSso"/>
				<element value="saml_ldap_sso"/>
			</property>
		</properties>
	</rule>
	<file>./src</file>
	<file>./saml-ldap-sso.php</file>
	<file>./helpers.php</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
